# Copy to .env, or run scripts/setup.ps1 to generate random passwords.
MCM_ADMIN_USERNAME=admin
MCM_ADMIN_PASSWORD=
MCM_DB_PASSWORD=
MCM_STATISTICS_ZONE=Asia/Hong_Kong
# Set the browser-facing origin when serving through an HTTPS reverse proxy.
# HTTPS automatically requires Secure session cookies.
MCM_PUBLIC_BASE_URL=
# Optional Secure-cookie override for other deployments. Local HTTP uses false.
MCM_COOKIE_SECURE=false
MCM_WEB_BIND=127.0.0.1
MCM_WEB_PORT=8088
# Game archives are stored in the backups Docker volume, separately from PostgreSQL.
# Nginx's content endpoint permits up to 16 GiB; raising this requires changing both limits.
MCM_BACKUP_MAX_UPLOAD_BYTES=17179869184
MCM_BACKUP_EXPANDED_LIMIT=137438953472
# Per-server policies remain off until enabled in the backup center.
MCM_BACKUP_POLICY_WORKER_ENABLED=true
# Optional map deployment with compose.map.yaml; use the actual archive UUID.
MCM_MAP_SERVER_ID=
MCM_MAP_PUBLIC_URL=http://127.0.0.1:18091
MCM_MAP_PORT=18091
MCM_MAP_BIND=127.0.0.1
# Private original-plugin upload URL key, generated separately from viewing URLs.
MCM_MAP_INGEST_KEY=
