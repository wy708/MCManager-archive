# The original plugin supports configurable upload URLs, without extra headers.
server {
    listen 80;
    server_tokens off;
    client_max_body_size 2m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $mipmap http://mipmap:8000;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location = / { return 302 /maps/${MCM_MAP_SERVER_ID}/; }
    location ^~ /maps/${MCM_MAP_SERVER_ID}/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        rewrite ^/maps/${MCM_MAP_SERVER_ID}/(.*)$ /$1 break;
        proxy_set_header Accept-Encoding "";
        proxy_pass $mipmap;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        sub_filter_once off;
        sub_filter_types text/css application/javascript text/javascript;
        sub_filter '"/api/' '"/maps/${MCM_MAP_SERVER_ID}/api/';
        sub_filter '`/api/' '`/maps/${MCM_MAP_SERVER_ID}/api/';
        sub_filter '"/static/' '"/maps/${MCM_MAP_SERVER_ID}/static/';
    }
    location = /upload/${MCM_MAP_INGEST_KEY}/chunks {
        access_log off;
        if ($request_method != POST) { return 405; }
        proxy_pass $mipmap/api/chunks-data;
    }
    location = /upload/${MCM_MAP_INGEST_KEY}/players {
        access_log off;
        if ($request_method != POST) { return 405; }
        proxy_pass $mipmap/api/players-data;
    }
    location /upload/ { access_log off; return 404; }
    location = /api/chunks-data { return 405; }
    location = /api/players-data { return 405; }
    location / { return 404; }
}
