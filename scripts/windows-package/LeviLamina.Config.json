{
  "version": 43,
  "language": "system",
  "logRotate": {
    "rotateOnOpen": true,
    "maxFileSize": 33554432,
    "interval": "Daily",
    "compress": true,
    "keepUncompressed": 7,
    "cleanup": true,
    "maxFiles": 1024,
    "maxAgeDays": 120,
    "totalSizeCap": 536870912
  },
  "modules": {
    "command": {
      "tpdimCommand": {
        "enabled": true,
        "permission": "GameDirectors"
      },
      "crashCommand": {
        "enabled": false,
        "permission": "GameDirectors"
      },
      "versionCommand": {
        "enabled": true,
        "permission": "GameDirectors"
      },
      "modManageCommand": {
        "enabled": true,
        "permission": "Admin"
      }
    },
    "crashLogger": {
      "enabled": true,
      "builtin": false,
      "uploadToSentry": false
    },
    "disableAutoCompactionLog": true
  },
  "targeted": {
    "enableStatistics": false,
    "simpleServerLogger": {
      "enabled": false,
      "playerChat": true,
      "playerCommand": true,
      "playerPermission": true
    },
    "forceEnableCheatCommands": false,
    "checkRunningBDS": true,
    "preserveInputLine": true,
    "netherNetPatch": {
      "enable": false,
      "stunServers": [
        "stun:stun.l.google.com:19302",
        "stun:stun.miwifi.com:3478"
      ]
    },
    "playerInfo": {
      "alwaysLaunch": false
    },
    "vulnerabilityFixes": {
      "enable": true,
      "subChunkRequest": true,
      "itemReadUserData": true,
      "disconnectClient": true,
      "limitIPFrequency": true,
      "simulatedPlayerChunkLoading": true
    }
  }
}
